# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Optional: backend auto-initializes embedded in-memory MongoDB if not connected)
MONGODB_URI=mongodb://localhost:27017/finance_adviser

# Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Backend only - never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application URL
CLIENT_URL=http://localhost:5173
